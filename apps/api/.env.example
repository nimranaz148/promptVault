# PromptVault API — environment variables (PRD Section 11)
PORT=5000
NODE_ENV=development

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Text AI provider — pick ONE and set TEXT_AI_PROVIDER accordingly
TEXT_AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Image AI provider — pollinations needs no key (default, MVP-friendly)
IMAGE_GEN_PROVIDER=pollinations
HUGGINGFACE_API_KEY=

# Supabase Storage bucket names (PRD Section 8)
AVATARS_BUCKET=avatars
GENERATED_IMAGES_BUCKET=generated-images
